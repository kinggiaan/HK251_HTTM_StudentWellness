# Strapi Configuration for ML Service
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Instructions:
# 1. Login to Strapi Admin: http://localhost:1337/admin
# 2. Go to Settings → API Tokens → Create new API Token
# 3. Name: "ML Service Token"
# 4. Token type: "Full access"
# 5. Copy the generated token and paste it above (STRAPI_API_TOKEN=your-token-here)
# 6. Save this file as ".env" (remove .template)
# 7. Restart ML service: python main.py
